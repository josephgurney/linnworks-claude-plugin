# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit the real file.
#
# How to get these values:
#   1. Create an app in the Linnworks developer portal to get APPLICATION_ID + APPLICATION_SECRET
#   2. Visit https://apps.linnworks.net/Authorization/Authorize/{LINNWORKS_APPLICATION_ID}
#      while logged into Linnworks — the Permanent Token is shown on that page
#   3. Paste the Permanent Token below as LINNWORKS_INSTALLATION_TOKEN

LINNWORKS_APPLICATION_ID=your-application-id-here
LINNWORKS_APPLICATION_SECRET=your-application-secret-here
LINNWORKS_INSTALLATION_TOKEN=your-installation-token-here

# ---------------------------------------------------------------------------
# OPTIONAL — deployment defaults.
#
# The Shopify store (Linnworks SubSource) the listing tools act on when a call
# doesn't name one. Leave blank and those tools ask which store, listing yours.
# LINNWORKS_DEFAULT_SHOPIFY_SUB_SOURCE=My Shopify Store
#
# Marker/service SKUs that find_unlinked_order_lines should never report as
# orphaned channel lines (comma-separated, case-insensitive).
# LINNWORKS_INTERNAL_SKUS=gift-wrap,check-notes
#
# An order identifier (tag) that marks an order as ready to pick.
# generate_pick_waves warns about any order without it. Blank = no check.
# LINNWORKS_PICKWAVE_READY_TAG=READY_TO_PICK

# ---------------------------------------------------------------------------
# OPTIONAL — Shopify Admin API, used ONLY by repair_channel_listing_images.
#
# Every other tool talks to Linnworks alone. That one tool writes corrected
# images onto live Shopify listings, which the Linnworks GLT cannot do (it
# re-pushes the template's stored, sometimes deleted, image URL and silently
# no-ops). Leave these unset and the tool returns setup
# instructions instead of writing anything; nothing else is affected.
#
# How to get a token:
#   Shopify admin > Settings > Apps and sales channels > Develop apps >
#   Create an app > Admin API scopes: read_products, write_products,
#   read_files, write_files > Install > copy the Admin API access token.

# Single-store form — applies to SHOPIFY_DEFAULT_SUB_SOURCE (which falls back
# to LINNWORKS_DEFAULT_SHOPIFY_SUB_SOURCE).
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-api-access-token
# SHOPIFY_DEFAULT_SUB_SOURCE=My Shopify Store

# Multi-store form — JSON keyed by the Linnworks SubSource. Takes precedence
# over the single-store vars. Use this if you repair listings on more than one
# store.
# SHOPIFY_STORES={"Store A":{"shop_domain":"a.myshopify.com","access_token":"shpat_..."},"Store B":{"shop_domain":"b.myshopify.com","access_token":"shpat_..."}}

# Admin API version to call (default 2026-01).
# SHOPIFY_API_VERSION=2026-01
